				</textElement>
				<text><![CDATA[This Report is issued without prejudice & bias, holding the right to amend/alter unintentional error/omission, if any.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="13" y="370" width="526" height="40" uuid="1e513373-b4fa-4015-b9a2-f04d98566e27"/>
