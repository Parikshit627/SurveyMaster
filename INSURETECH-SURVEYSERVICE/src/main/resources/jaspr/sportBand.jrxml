	<detail>
		<band height="742" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="10" y="6" width="524" height="13" backcolor="#F0EDED" uuid="2ed64a4b-6b85-4363-85aa-3df23b30753d"/>
				<box padding="-2">
					<pen lineWidth="0.0" lineStyle="Solid" lineColor="#F5F2F2"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Serif" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[SURVEY/INSPECTION DEATAILS:]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" x="13" y="137" width="523" height="120" uuid="66f18bb2-6eed-4e88-8cd3-d35a829890ba">
					<property name="com.jaspersoft.studio.unit.y" value="px"/>
				</reportElement>
				<box>
					<pen lineWidth="0.0" lineStyle="Solid" lineColor="#F5F2F2"/>
				</box>
				<textElement textAlignment="Left">
					<font fontName="Serif" isBold="false" isItalic="true"/>
				</textElement>
				<text><![CDATA[During the survey, utmost care and caution were exercised to ensure that all damages were duly noted. However, in the event that any damage remains unnoticed or is discovered after the insured vehicle is dismantled, it is advised that the final surveyor make an appropriate decision regarding the matter. This approach emphasizes the importance of thorough assessment and allows for any unforeseen damages to be addressed accordingly.]]></text>
			</staticText>
			<staticText>
				<reportElement positionType="Float" mode="Opaque" x="12" y="290" width="528" height="16" backcolor="#F0EDED" uuid="179fdb53-cfb1-4867-b405-79570052205f"/>
				<box>
					<pen lineWidth="0.0" lineStyle="Solid" lineColor="#F5F2F2"/>
				</box>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Serif" size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[CONCLUDING REMARKS]]></text>
			</staticText>
			<textField isBlankWhenNull="true">
